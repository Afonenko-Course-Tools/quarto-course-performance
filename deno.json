{
  "version": "2.0.0",
  "tasks": {
    "perf": "deno run --config deno.json --lock deno.lock --frozen --node-modules-dir=manual --cached-only -A src/cli.ts",
    "test": "deno test -A tests",
    "check": "deno check src/ bridge/ tools/ && deno fmt --check src bridge tools tests",
    "check:perfetto": "deno run -A tools/check-perfetto.ts",
    "check:java": "deno run -A tools/check-java-general-use.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100
  }
}
